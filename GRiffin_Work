@app.route("/")
def home():
    q = request.args.get("q", "").strip()
    selected_year = request.args.get("year", "").strip()

    sql = "SELECT * FROM records WHERE 1=1"
    params = []

    if q:
        pattern = f"%{q}%"
        sql += """
            AND (
                student LIKE ? OR issue LIKE ?
                OR request LIKE ? OR details LIKE ?
            )
        """
        params.extend([pattern, pattern, pattern, pattern])

    if selected_year:
        sql += " AND school_year = ?"
        params.append(selected_year)

    sql += """
        ORDER BY
            CASE WHEN scheduled_at = '' THEN 1 ELSE 0 END,
            scheduled_at ASC,
            id ASC
    """

    with get_db() as db:
        records = db.execute(sql, params).fetchall()
        years = [
            row["school_year"]
            for row in db.execute("""
                SELECT DISTINCT school_year
                FROM records
                ORDER BY school_year DESC
            """).fetchall()
        ]

    return render_template_string(
        PAGE,
        records=records,
        school_year=current_school_year(),
        years=years,
        q=q,
        selected_year=selected_year
    )


# -------------------------
# ADD ONE RECORD
# -------------------------

@app.route("/add", methods=["POST"])
def add():
    student = request.form.get("student", "").strip()
    issue = request.form.get("issue", "").strip()
    help_request = request.form.get("request", "").strip()
    details = request.form.get("details", "").strip()
    scheduled_text = request.form.get("scheduled_at", "").strip()

    if not student or not issue:
        return "Student and issue are required.", 400

    if len(student) > 150 or len(issue) > 200:
        return "One of the fields is too long.", 400

    scheduled_at = ""

    if scheduled_text:
        try:
            scheduled_at = datetime.strptime(
                scheduled_text, "%Y-%m-%dT%H:%M"
            ).strftime("%Y-%m-%d %H:%M")
        except ValueError:
            return "Invalid scheduled date and time.", 400

    recorded_at = datetime.now().astimezone().isoformat(
        sep=" ", timespec="seconds"
    )

    with get_db() as db:
        db.execute("""
            INSERT INTO records
            (student, issue, details, request, scheduled_at,
             recorded_at, school_year)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (
            student, issue, details, help_request,
            scheduled_at, recorded_at, current_school_year()
        ))

    return redirect(url_for("home"))


# -------------------------
# IMPORT CSV FILE
# -------------------------

@app.route("/import-csv", methods=["POST"])
def import_csv():
    uploaded = request.files.get("file")

    if not uploaded or not uploaded.filename.lower().endswith(".csv"):
        return "Please select a CSV file.", 400

    try:
        content = uploaded.stream.read(5 * 1024 * 1024 + 1)

        if len(content) > 5 * 1024 * 1024:
            return "CSV is too large. Maximum size is 5 MB.", 400

        content = content.decode("utf-8-sig")
        reader = csv.DictReader(io.StringIO(content))

        required = {
            "student_name", "issue", "request", "scheduled_at"
        }

        if not reader.fieldnames or not required.issubset(
            set(reader.fieldnames)
        ):
            return (
                "CSV must contain student_name, issue, "
                "request, scheduled_at.",
                400
            )

        rows = []

        for line_number, row in enumerate(reader, start=2):
            student = (row.get("student_name") or "").strip()
            issue = (row.get("issue") or "").strip()
            help_request = (row.get("request") or "").strip()
            scheduled_text = (row.get("scheduled_at") or "").strip()

            if not student or not issue or not scheduled_text:
                return (
                    f"Missing student, issue, or time on row {line_number}.",
                    400
                )

            if len(student) > 150 or len(issue) > 200:
                return f"Text too long on row {line_number}.", 400

            try:
                scheduled = datetime.strptime(
                    scheduled_text, "%Y-%m-%d %H:%M"
                )
            except ValueError:
                return (
                    f"Invalid date/time on row {line_number}. "
                    "Use YYYY-MM-DD HH:MM.",
                    400
                )

            recorded_at = datetime.now().astimezone().isoformat(
                sep=" ", timespec="seconds"
            )

            start_year = (
                scheduled.year if scheduled.month >= 8
                else scheduled.year - 1
            )
            school_year = f"{start_year}-{start_year + 1}"

            rows.append((
                student, issue, "", help_request,
                scheduled.strftime("%Y-%m-%d %H:%M"),
                recorded_at, school_year
            ))

        if not rows:
            return "No records found in the CSV.", 400

        # Insert every row in one transaction.
        with get_db() as db:
            db.executemany("""
                INSERT INTO records
                (student, issue, details, request, scheduled_at,
                 recorded_at, school_year)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """, rows)

        return redirect(url_for("home"))

    except UnicodeDecodeError:
        return "Please save the CSV as UTF-8.", 400
    except csv.Error:
        return "Could not read the CSV file.", 400


# -------------------------
# EXPORT CSV
# -------------------------

@app.route("/export")
def export():
    q = request.args.get("q", "").strip()
    selected_year = request.args.get("year", "").strip()

    sql = "SELECT * FROM records WHERE 1=1"
    params = []

    if q:
        pattern = f"%{q}%"
        sql += """
            AND (
                student LIKE ? OR issue LIKE ?
                OR request LIKE ? OR details LIKE ?
            )
        """
        params.extend([pattern, pattern, pattern, pattern])

    if selected_year:
        sql += " AND school_year = ?"
        params.append(selected_year)

    sql += " ORDER BY scheduled_at, id"

    with get_db() as db:
        records = db.execute(sql, params).fetchall()

    output = io.StringIO()
    writer = csv.writer(output)

    writer.writerow([
        "student_name", "issue", "request", "scheduled_at",
        "school_year", "recorded_at", "details"
    ])

    for r in records:
        writer.writerow([
            r["student"], r["issue"],
            r["request"] or "", r["scheduled_at"] or "",
            r["school_year"], r["recorded_at"],
            r["details"] or ""
        ])

    return Response(
        "\ufeff" + output.getvalue(),
        mimetype="text/csv; charset=utf-8",
        headers={
            "Content-Disposition":
                'attachment; filename="student_records.csv"'
        }
    )



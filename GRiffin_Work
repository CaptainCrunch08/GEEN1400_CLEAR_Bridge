from flask import Flask, request, redirect, Response, render_template_string, url_for
import sqlite3
import csv
import io
from datetime import datetime

app = Flask(__name__)
DB = "students.db"


# -------------------------
# DATABASE
# -------------------------

def get_db():
    db = sqlite3.connect(DB)
    db.row_factory = sqlite3.Row
    return db


def current_school_year():
    now = datetime.now()
    start = now.year if now.month >= 8 else now.year - 1
    return f"{start}-{start + 1}"


def initialize_db():
    with get_db() as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS records (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                student TEXT NOT NULL,
                issue TEXT NOT NULL,
                details TEXT DEFAULT '',
                request TEXT NOT NULL DEFAULT '',
                scheduled_at TEXT NOT NULL DEFAULT '',
                recorded_at TEXT NOT NULL,
                school_year TEXT NOT NULL
            )
        """)

        columns = {
            row["name"]
            for row in db.execute("PRAGMA table_info(records)")
        }

        if "request" not in columns:
            db.execute("""
                ALTER TABLE records
                ADD COLUMN request TEXT NOT NULL DEFAULT ''
            """)

        if "scheduled_at" not in columns:
            db.execute("""
                ALTER TABLE records
                ADD COLUMN scheduled_at TEXT NOT NULL DEFAULT ''
            """)

        if "details" not in columns:
            db.execute("""
                ALTER TABLE records
                ADD COLUMN details TEXT DEFAULT ''
            """)


